# ===== Build outputs =====
build/
out/
target/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar

# ===== Gradle =====
.gradle/
!gradle-wrapper.properties

# ===== IntelliJ IDEA =====
.idea/
*.iml
*.ipr
*.iws

# ===== Eclipse =====
.classpath
.project
.settings/
.metadata/
bin/

# ===== VSCode =====
.vscode/
*.code-workspace

# ===== NetBeans =====
nbproject/
nbbuild/
nbdist/
build/
dist/

# ===== Logs =====
*.log
logs/

# ===== SQLite databases (dev/test) =====
*.db
*.db-journal
*.db-wal
*.db-shm
run/plugins/EverWar/everwar.db*

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Test server folder =====
run/
server/
plugins/

# ===== Python helper scripts (optional — comment if want to commit) =====
# build.py
# setup.py
# check_structure.py
# fix_warnings.py
# copy_to_server.py

# ===== Backup files =====
*.bak
*.backup
*.orig
*~

# ===== Environment =====
.env
.env.local


